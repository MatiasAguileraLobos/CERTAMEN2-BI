            <component
              refId="Package\DFT_Cargar_Dim_Cliente\SRC_Clientes"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="SRC_Clientes"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    c.cliente_id AS Cliente_BK,
    UPPER(
        TRIM(
            CONCAT(
                c.nombre, ' ',
                c.appaterno, ' ',
                c.apmaterno
            )
        )
    ) AS NombreCompleto,
    c.sexo AS Sexo,
    CAST(c.fecha_nacimiento AS DATE) AS FechaNacimiento,
    c.estado_civil AS EstadoCivil,
    CASE
        WHEN c.fecha_nacimiento IS NULL THEN 'DESCONOCIDO'
        WHEN DATEADD(YEAR, DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()),
                     c.fecha_nacimiento) &gt; CAST(GETDATE() AS DATE)
            THEN
                CASE
                    WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) - 1 &lt; 25 THEN '18-24'
                    WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) - 1 &lt; 35 THEN '25-34'
                    WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) - 1 &lt; 45 THEN '35-44'
                    WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) - 1 &lt; 60 THEN '45-59'
                    ELSE '60+'
                END
        WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) &lt; 25 THEN '18-24'
        WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) &lt; 35 THEN '25-34'
        WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) &lt; 45 THEN '35-44'
        WHEN DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()) &lt; 60 THEN '45-59'
        ELSE '60+'
    END AS RangoEtario
FROM dbo.clientes AS c;</property>
                <property
