                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    e.empleado_id AS Empleado_BK,
    UPPER(
        TRIM(
            CONCAT(
                e.nombre, ' ',
                e.appaterno, ' ',
                e.apmaterno
            )
        )
    ) AS NombreCompleto,
    c.nombre AS Cargo,
    CAST(e.fecha_contrato AS DATE) AS FechaContrato,
    CAST(e.sueldo_base AS DECIMAL(12,2)) AS SueldoBase
FROM dbo.empleados AS e
INNER JOIN dbo.cargos AS c
    ON e.cargo_id = c.cargo_id;</property>
