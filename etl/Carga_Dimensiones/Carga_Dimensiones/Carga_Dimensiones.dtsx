                    <outputColumn
                      refId="Package\DFT_Cargar_Fact_Ventas\Origen de OLE DB.Outputs[Salida de origen de OLE DB].Columns[Cliente_SK]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
