                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Cargar_Fact_Ventas\Origen de OLE DB.Outputs[Salida de origen de OLE DB].ExternalColumns[Tiempo_SK]"
